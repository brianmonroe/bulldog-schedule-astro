---
import { getImage } from 'astro:assets';
import boosterImage from '../images/2026-football-celina-vs-bath-160.webp';

const csvUrl = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vQPpyrUb-lQhr3epqEU3A-a2vVk46o9tlKcO7PKKG41dDoZe77wQ5M0GNYRSas6KU8BIoHZtlF0jC81/pub?gid=1559160550&single=true&output=csv';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const { view = 'upcoming' } = Astro.props;
const isWeek = view === 'week';
const pageTitle = isWeek ? 'Celina Bulldogs — Next 7 Days' : 'Celina Bulldogs Winter Sports Schedule';
const pageDescription = isWeek
  ? 'See Celina Bulldogs athletic events happening today and over the next seven days.'
  : 'Browse today and upcoming Celina Bulldogs athletic events, times, opponents, and venues.';
const pageUrl = new URL(isWeek ? `${base}week/` : base, Astro.site ?? Astro.url.origin);
const socialImage = await getImage({ src: boosterImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#063f2e" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Celina Bulldogs" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Celina Bulldogs football players taking the field" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles.css`} />
    <link rel="stylesheet" href={`${base}print.css`} />
  </head>
  <body data-csv-url={csvUrl} data-view={view}>
    <main>
      <section class="hero shell">
        <p class="eyebrow">Celina Bulldogs</p>
        <h1>Winter 2026/2027<br /><em>Sports</em></h1>
        <aside class="sponsor" aria-label="Schedule sponsor">
          <p>Brought to you by</p>
          <img src={`${base}sponsor-banner.svg`} alt="Sponsor banner" width="1200" height="220" />
        </aside>
      </section>

      <section class="schedule shell" aria-labelledby="schedule-title">
        <div class="section-heading">
          <p id="result-count" class="result-count" aria-live="polite">Loading…</p>
        </div>

        <div class="filter-panel">
          <label class="search-field">
            <span class="sr-only">Search schedule</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
            <input id="search" type="search" placeholder="Search opponent or venue" autocomplete="off" />
          </label>
          <div class="quick-filters" aria-label="Quick filters">
            <button class="chip active" type="button" data-quick="all" aria-pressed="true">All events</button>
            <button class="chip" type="button" data-quick="home" aria-pressed="false">Home</button>
            <button class="chip" type="button" data-quick="away" aria-pressed="false">Away</button>
          </div>
          <div class="select-grid">
            <label><span>Sport</span><select id="sport"><option value="">All sports</option></select></label>
            <label><span>Level</span><select id="level"><option value="">All levels</option></select></label>
            <label><span>Team</span><select id="team"><option value="">All teams</option></select></label>
          </div>
          <div class="filter-actions">
            <button id="clear" class="clear-button" type="button" hidden>Clear all filters</button>
            <button id="print" class="print-button" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3h10v6M7 18H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M7 14h10v7H7z"></path></svg>
              Print current view
            </button>
          </div>
        </div>

        <div class="print-heading" aria-hidden="true">
          <div><span class="print-mark">C</span><p><strong>Celina Bulldogs</strong><small>2026–27 Winter Schedule</small></p></div>
          <p id="print-summary"></p>
        </div>
        <div id="loading" class="status-card"><span class="loader"></span><p>Getting the latest schedule…</p></div>
        <div id="error" class="status-card error" hidden><p><strong>We couldn’t load the schedule.</strong><br />Check your connection and try again.</p><button type="button" id="retry">Try again</button></div>
        <div id="events" class="events" aria-live="polite"></div>
        <div id="empty" class="status-card" hidden><p><strong>No events match those filters.</strong><br />Try broadening your search.</p><button type="button" id="reset">Reset filters</button></div>
      </section>

      <section class="booster-cta shell" aria-labelledby="booster-title" style={`--booster-image: url(${boosterImage.src})`}>
        <div>
          <p class="booster-kicker">Celina Athletic Booster Club</p>
          <h2 id="booster-title">Join &amp; Support the Dogs</h2>
          <p>Help provide equipment, opportunities, and support for Celina student-athletes.</p>
        </div>
        <a href="https://www.celinaschools.org/A_BoosterClub.aspx" target="_blank" rel="noopener noreferrer">Become a Booster <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer>
      <div class="shell footer-grid">
        <div class="footer-brand">
          <span>Go Bulldogs</span>
          <p>Schedules are subject to change.</p>
        </div>
        <nav class="footer-resources" aria-label="Celina resources">
          <p>Helpful links</p>
          <a href="https://www.celinaschools.org/" target="_blank" rel="noopener noreferrer">Celina Schools Website <span aria-hidden="true">↗</span></a>
          <a href="https://www.facebook.com/CelinaAthletics/" target="_blank" rel="noopener noreferrer">Celina Athletics Facebook Page <span aria-hidden="true">↗</span></a>
          <a href="https://www.facebook.com/CelinaSchools/" target="_blank" rel="noopener noreferrer">Celina Schools Facebook Page <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="footer-meta">
          <div>
            <p>Schedule views</p>
            <a href={`${base}week/`}>Next 7 days</a>
          </div>
          <div>
            <p>Administration</p>
            <a href={`${base}guide/`}>Admin guide</a>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline src={`${base}schedule.js`}></script>
  </body>
</html>
