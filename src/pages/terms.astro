---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Terms of use for the independently published Celina Bulldogs schedule." />
    <meta name="theme-color" content="#063f2e" />
    <title>Terms of Use | Celina Bulldogs Schedule</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles.css`} />
    <link rel="stylesheet" href={`${base}legal.css`} />
  </head>
  <body>
    <main class="legal-page shell">
      <header class="legal-header">
        <p class="eyebrow">Site information</p>
        <h1>Terms of Use</h1>
        <p>Last updated October 21, 2026</p>
      </header>

      <div class="legal-content">
        <section>
          <h2>Independent publication</h2>
          <p>This site is independently published and managed and is not directly affiliated with, endorsed by, or operated by Celina City Schools.</p>
        </section>

        <section>
          <h2>Schedule information</h2>
          <p>The schedule is provided as a convenient public reference. Events, times, venues, opponents, ticket availability, and broadcast details may change without notice. Visitors should confirm important details with the school, event venue, or event organizer before traveling or making a purchase.</p>
        </section>

        <section>
          <h2>Links and beta features</h2>
          <p>Stream and ticket links may be provided for testing or convenience. A link does not constitute an endorsement or guarantee that the destination, broadcast, ticket, price, or event information is accurate or available.</p>
          <p>Third-party websites operate under their own terms and policies. This site is not responsible for third-party content, transactions, availability, or security.</p>
        </section>

        <section>
          <h2>Use of the site</h2>
          <p>You may use this site for lawful, personal, and informational purposes. Do not attempt to disrupt the site, interfere with its operation, or misuse its content or services.</p>
        </section>

        <section>
          <h2>No warranties</h2>
          <p>The site and its information are provided “as is” and “as available,” without warranties regarding accuracy, completeness, availability, or fitness for a particular purpose.</p>
        </section>

        <section>
          <h2>Changes</h2>
          <p>These terms and the site’s features may be updated at any time. Continued use after an update means you accept the revised terms.</p>
        </section>
      </div>

      <a class="legal-back" href={base}><svg class="link-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4M8 6l-4 4 4 4"></path></svg> Return to schedule</a>
    </main>
  </body>
</html>
